# ATH IDE — Terraform Deployment Variables Example
# Copy this file to terraform.tfvars:
#   cp terraform.tfvars.example terraform.tfvars

project_id = "your-gcp-project-id"
region     = "us-central1"
zone       = "us-central1-a"
app_name   = "ath-ide"

github_repository     = "atharv20s/vscode_cli"
github_actions_branch = "main"
image_tag             = "release-sha" # Prefer immutable image tags, not latest

# Populate the Secret Manager secrets before deploying Cloud Run.

# Optional Custom Domain (e.g. ide.yourdomain.com)
domain_name = ""
