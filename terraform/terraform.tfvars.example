# ATH IDE GCP Terraform inputs. No credential values belong in this file.
# Copy to terraform.tfvars and supply non-secret identifiers only.

project_id        = "your-gcp-project-id"
region            = "us-central1"
zone              = "us-central1-a"
app_name           = "ath-ide"
image_tag          = "replace-with-an-immutable-git-sha"
github_repository  = "atharv20s/vscode_cli"

# Public access is disabled by default. Enable only when app-level auth is ready.
allow_public_access = false

# GKE provisions billable compute; leave disabled unless you need Kubernetes.
enable_gke = false

# Optional DNS zone only. Cloud Run domain verification and DNS records are
# configured after Terraform creates the zone.
domain_name = ""
