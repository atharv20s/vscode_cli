#!/bin/bash
set -Eeuo pipefail

dnf update -y
dnf install -y docker git python3 jq curl awscli gcc-c++ make
curl -fsSL https://rpm.nodesource.com/setup_22.x | bash -
dnf install -y nodejs
systemctl enable --now docker

id ubuntu >/dev/null 2>&1 || useradd --create-home ubuntu
usermod -aG docker ubuntu
WORKER_UID="$(id -u ubuntu)"
WORKER_GID="$(id -g ubuntu)"
install -d -o root -g root -m 0755 /etc/ath-ide
install -d -o ubuntu -g ubuntu -m 0700 /var/lib/ath-ide/worker

aws --region "${aws_region}" secretsmanager get-secret-value \
  --secret-id "${worker_secret_arn}" --query SecretString --output text |
python3 -c '
import json, re, sys
data = json.load(sys.stdin)
for key, value in data.items():
    if not re.fullmatch(r"[A-Z][A-Z0-9_]*", key):
        raise SystemExit("Invalid environment variable name in worker bootstrap secret")
    if not isinstance(value, (str, int, float, bool)):
        raise SystemExit("Worker bootstrap secret values must be scalar")
    value = str(value)
    if "\n" in value or "\r" in value:
        raise SystemExit("Multiline values are not supported in worker EnvironmentFile")
    value = value.replace("\\\\", "\\\\\\\\").replace(chr(34), chr(92) + chr(34))
    print(key + "=" + chr(34) + value + chr(34))
' > /etc/ath-ide/worker.env

cat >> /etc/ath-ide/worker.env <<ENV
NODE_ENV=production
EXECUTION_RUNTIME=docker
WORKER_PORT=8081
WORKSPACE_ROOT=/var/lib/ath-ide/worker
WORKSPACE_OBJECT_STORE_BUCKET=${workspace_bucket}
WORKSPACE_OBJECT_STORE_REQUIRED=true
WORKSPACE_OBJECT_STORE_USE_EC2_ROLE=true
WORKSPACE_OBJECT_STORE_SERVER_SIDE_ENCRYPTION=${kms_key_id == "" ? "AES256" : "aws:kms"}
DOCKER_WORKSPACE_IMAGE=${workspace_image}
DOCKER_WORKSPACE_UID=${WORKER_UID}
DOCKER_WORKSPACE_GID=${WORKER_GID}
DOCKER_WORKSPACE_NETWORK=none
REPO_AGENT_NETWORK=none
DOCKER_SECCOMP_PROFILE=/etc/ath-ide/seccomp-workspace.json
ENV
chmod 0600 /etc/ath-ide/worker.env
chown root:root /etc/ath-ide/worker.env

if [[ -n "${kms_key_id}" ]]; then
  printf 'WORKSPACE_OBJECT_STORE_KMS_KEY_ID=%s\n' "${kms_key_id}" >> /etc/ath-ide/worker.env
fi

git clone --depth 1 --branch "${repository_branch}" "${repository_url}" /home/ubuntu/ath-ide
chown -R ubuntu:ubuntu /home/ubuntu/ath-ide
runuser -u ubuntu -- env HOME=/home/ubuntu npm ci --prefix /home/ubuntu/ath-ide/server
docker build -f /home/ubuntu/ath-ide/server/Dockerfile.workspace -t "${workspace_image}" /home/ubuntu/ath-ide

bash /home/ubuntu/ath-ide/scripts/install-worker-security.sh
systemctl enable --now ath-ide-worker.service
