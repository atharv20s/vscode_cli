# ============================================
# ATH IDE -- Autonomous AI Development Studio
# Environment Variables
# ============================================
# Copy this file to .env:
#   cp .env.example .env
# ============================================

# ------------------------------------------
# 1. LLM API Keys (Required: at least one)
# ------------------------------------------

# OpenRouter (choose explicit model IDs from your provider dashboard)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Never set these to openrouter/free for production code generation.
OPENROUTER_FAST_MODEL=
OPENROUTER_CODING_MODEL=
OPENROUTER_REASONING_MODEL=
OPENROUTER_VISION_MODEL=

# Mistral Direct (optional provider and fallback)
# MISTRAL_API_KEY=...
# MISTRAL_FAST_MODEL=mistral-small-latest
# MISTRAL_CODING_MODEL=codestral-latest
# MISTRAL_REASONING_MODEL=mistral-large-latest
# MISTRAL_VISION_MODEL=pixtral-12b-2409

# Provider routing. Fallbacks are attempted only when explicitly configured.
DEFAULT_LLM_PROVIDER=openrouter
LLM_FALLBACK_PROVIDERS=mistral

# Context budgets are in tokens, not characters. Keep budget + output + safety
# below the selected model's actual context window.
LLM_CONTEXT_WINDOW_TOKENS=65536
LLM_CONTEXT_BUDGET_TOKENS=48000
LLM_OUTPUT_RESERVE_TOKENS=12288
LLM_CONTEXT_SAFETY_TOKENS=2048

# OpenAI Direct (optional; configure actual model IDs for each tier)
# OPENAI_API_KEY=sk-...
# OPENAI_FAST_MODEL=
# OPENAI_CODING_MODEL=
# OPENAI_REASONING_MODEL=
# OPENAI_VISION_MODEL=

# Anthropic Direct (Optional)
# ANTHROPIC_API_KEY=sk-ant-...

# Ollama Local (Optional -- 100% offline free models)
# OLLAMA_BASE_URL=http://localhost:11434/v1

# ------------------------------------------
# 2. AI Web Search (Required for web tools)
# ------------------------------------------

# Tavily AI Search (1,000 free searches per month)
# Get a free key at: https://tavily.com
TAVILY_API_KEY=your_tavily_key_here

# ------------------------------------------
# 3. GitHub OAuth & Git Integration (Optional)
# ------------------------------------------

# Create an OAuth App at: https://github.com/settings/developers
# Homepage URL: http://localhost:3001
# Authorization callback URL: http://localhost:3001/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_oauth_app_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_secret
# GITHUB_PERSONAL_ACCESS_TOKEN=ghp_...

# ------------------------------------------
# 4. Database & Redis Cache
# ------------------------------------------

# Database Type: 'sqlite' (default, zero setup) or 'mysql' (Docker)
DB_TYPE=sqlite

# MySQL Configuration (if using Docker or local MySQL)
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=secret
MYSQL_DATABASE=agentic_db

# Redis URL (local development or shared production Redis)
REDIS_URL=redis://localhost:6379

# Shared Postgres is required for production/multi-worker repository agents.
# DATABASE_URL=postgresql://user:password@localhost:5432/athide?sslmode=require

# Repository-agent worker sandbox policy (worker process only)
# Worker startup: cd server && npm run worker:repo-agent
# Docker Engine + Git must be installed on each Linux worker host.
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep the same value in the API and every worker secret manager; never commit it.
REPO_AGENT_TOKEN_KEY=
EXECUTION_RUNTIME=disabled
REPO_AGENT_NETWORK=none
DOCKER_WORKSPACE_IMAGE=ath-ide-workspace:local
WORKSPACE_ROOT=./workspace
DOCKER_WORKSPACE_UID=1000
DOCKER_WORKSPACE_GID=1000
REPO_AGENT_LEASE_MS=120000
REPO_AGENT_MAX_ATTEMPTS=3

# Set REPO_AGENT_NETWORK=bridge only behind a host egress firewall or
# allowlisted package-registry proxy; Docker bridge alone is not a firewall.

# ------------------------------------------
# 5. Security & Server Settings
# ------------------------------------------

# JWT secret -- used to sign authentication tokens. Must be 32+ characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=super_secret_jwt_random_key_change_me

# Session secret -- used for express-session cookie signing
SESSION_SECRET=super_secret_session_random_key

# Server port (IDE frontend + API + WebSocket all served from this port)
PORT=3001

# Environment: 'development' | 'production'
NODE_ENV=development

# ------------------------------------------
# 6. Remote Cloud VM Terminal Sandbox
# ------------------------------------------
# Route agent terminal/shell commands to a remote cloud VM over SSH.
# Leave REMOTE_ENABLED=false to run everything on your local machine.
# Supports: Google Cloud Compute Engine, Oracle Cloud, AWS EC2, DigitalOcean, any Linux host.

REMOTE_ENABLED=false
REMOTE_HOST=
REMOTE_USER=ubuntu
REMOTE_SSH_KEY_PATH=
REMOTE_PORT=22
REMOTE_WORKSPACE=/home/ubuntu/agent-workspace

# Legacy Oracle Cloud aliases (also supported)
# OCI_REMOTE_ENABLED=false
# OCI_HOST=129.146.xxx.xxx
# OCI_USER=ubuntu
# OCI_SSH_KEY_PATH=~/.ssh/oci_key.pem
# OCI_PORT=22
# OCI_WORKSPACE=/home/ubuntu/agent-workspace

# Optional: Run commands inside an isolated Docker container on the VM
# REMOTE_DOCKER_CONTAINER=agentic-sandbox-runner

# ------------------------------------------
# 7. Cloudflare Tunnel / Tailscale (Optional)
# ------------------------------------------
# For exposing the IDE to the internet without port forwarding.
# After running: cloudflared tunnel --url http://localhost:3001
# Set PUBLIC_URL to the generated tunnel URL for CORS and OAuth callbacks.

# PUBLIC_URL=https://your-tunnel-name.trycloudflare.com

# ------------------------------------------
# 8. MCP Server Configuration (Optional)
# ------------------------------------------
# Path to MCP (Model Context Protocol) server config file
# MCP_CONFIG_PATH=./mcp_config.json

# ------------------------------------------
# 9. Workspace Configuration
# ------------------------------------------
# Override the default workspace root directory
# WORKSPACE_ROOT=/path/to/workspace

# ------------------------------------------
# 10. Durable workspace storage and quotas
# ------------------------------------------
# In production, mount the SAME durable shared filesystem on every API instance.
# Examples: a supported NFS/PersistentVolume mount. Do not use an ephemeral container path.
# WORKSPACE_STORAGE_ROOT=/var/lib/ath-ide/workspaces
WORKSPACE_QUOTA_BYTES=268435456
WORKSPACE_MAX_FILE_BYTES=2097152
WORKSPACE_MAX_SESSIONS_PER_USER=10
TERMINAL_IDLE_TTL_MS=1800000

# Dedicated remote execution worker (required for cloud workspaces)
# EXECUTION_RUNTIME=remote
# EXECUTION_WORKER_URL=https://worker.example.com
# WORKER_SHARED_SECRET=<32+ random bytes, shared only with the worker>

# Optional durable snapshots for worker replacement / cold-start recovery.
# Configure on the execution worker. Supports AWS S3 and S3-compatible providers.
# WORKSPACE_OBJECT_STORE_BUCKET=ath-workspaces
# WORKSPACE_OBJECT_STORE_REGION=us-east-1
# WORKSPACE_OBJECT_STORE_ENDPOINT=https://s3.us-east-1.amazonaws.com
# WORKSPACE_OBJECT_STORE_ACCESS_KEY_ID=
# WORKSPACE_OBJECT_STORE_SECRET_ACCESS_KEY=

# Set this to the browser-reachable WebSocket URL when frontend and API are
# deployed separately. Local development defaults to ws://<hostname>:3001/ws.
# NEXT_PUBLIC_WS_URL=wss://api.example.com/ws

# ------------------------------------------
# 11. Logging
# ------------------------------------------
# Log level: 'debug' | 'info' | 'warn' | 'error'
LOG_LEVEL=info
