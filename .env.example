# ============================================
# ATH IDE -- Autonomous AI Development Studio
# Environment Variables
# ============================================
# Copy this file to .env:
#   cp .env.example .env
# ============================================

# ------------------------------------------
# 1. LLM API Keys (Required: at least one)
# ------------------------------------------

# OpenRouter (Recommended -- single key gives access to Devstral, Qwen, DeepSeek, Claude, GPT-4o)
# Get a free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free

# OpenAI Direct (Optional)
# OPENAI_API_KEY=sk-...

# Anthropic Direct (Optional)
# ANTHROPIC_API_KEY=sk-ant-...

# Ollama Local (Optional -- 100% offline free models)
# OLLAMA_BASE_URL=http://localhost:11434/v1

# ------------------------------------------
# 2. AI Web Search (Required for web tools)
# ------------------------------------------

# Tavily AI Search (1,000 free searches per month)
# Get a free key at: https://tavily.com
TAVILY_API_KEY=your_tavily_key_here

# ------------------------------------------
# 3. GitHub OAuth & Git Integration (Optional)
# ------------------------------------------

# Create an OAuth App at: https://github.com/settings/developers
# Homepage URL: http://localhost:3001
# Authorization callback URL: http://localhost:3001/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_oauth_app_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_secret
# GITHUB_PERSONAL_ACCESS_TOKEN=ghp_...

# ------------------------------------------
# 4. Database & Redis Cache
# ------------------------------------------

# Database Type: 'sqlite' (default, zero setup) or 'mysql' (Docker)
DB_TYPE=sqlite

# MySQL Configuration (if using Docker or local MySQL)
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=secret
MYSQL_DATABASE=agentic_db

# Redis URL (if Docker Redis is running)
REDIS_URL=redis://localhost:6379

# ------------------------------------------
# 5. Security & Server Settings
# ------------------------------------------

# JWT secret -- used to sign authentication tokens. Must be 32+ characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=super_secret_jwt_random_key_change_me

# Session secret -- used for express-session cookie signing
SESSION_SECRET=super_secret_session_random_key

# Server port (IDE frontend + API + WebSocket all served from this port)
PORT=3001

# Environment: 'development' | 'production'
NODE_ENV=development

# ------------------------------------------
# 6. Remote Cloud VM Terminal Sandbox
# ------------------------------------------
# Route agent terminal/shell commands to a remote cloud VM over SSH.
# Leave REMOTE_ENABLED=false to run everything on your local machine.
# Supports: Google Cloud Compute Engine, Oracle Cloud, AWS EC2, DigitalOcean, any Linux host.

REMOTE_ENABLED=false
REMOTE_HOST=
REMOTE_USER=ubuntu
REMOTE_SSH_KEY_PATH=
REMOTE_PORT=22
REMOTE_WORKSPACE=/home/ubuntu/agent-workspace

# Legacy Oracle Cloud aliases (also supported)
# OCI_REMOTE_ENABLED=false
# OCI_HOST=129.146.xxx.xxx
# OCI_USER=ubuntu
# OCI_SSH_KEY_PATH=~/.ssh/oci_key.pem
# OCI_PORT=22
# OCI_WORKSPACE=/home/ubuntu/agent-workspace

# Optional: Run commands inside an isolated Docker container on the VM
# REMOTE_DOCKER_CONTAINER=agentic-sandbox-runner

# ------------------------------------------
# 7. Cloudflare Tunnel / Tailscale (Optional)
# ------------------------------------------
# For exposing the IDE to the internet without port forwarding.
# After running: cloudflared tunnel --url http://localhost:3001
# Set PUBLIC_URL to the generated tunnel URL for CORS and OAuth callbacks.

# PUBLIC_URL=https://your-tunnel-name.trycloudflare.com

# ------------------------------------------
# 8. MCP Server Configuration (Optional)
# ------------------------------------------
# Path to MCP (Model Context Protocol) server config file
# MCP_CONFIG_PATH=./mcp_config.json

# ------------------------------------------
# 9. Workspace Configuration
# ------------------------------------------
# Override the default workspace root directory
# WORKSPACE_ROOT=/path/to/workspace

# ------------------------------------------
# 10. Logging
# ------------------------------------------
# Log level: 'debug' | 'info' | 'warn' | 'error'
LOG_LEVEL=info
