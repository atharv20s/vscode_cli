FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash git tmux procps curl python3 python3-pip python3-venv build-essential curl ca-certificates unzip zip golang-go cargo rustc \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
CMD ["sleep", "infinity"]