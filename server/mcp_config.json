{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "./workspace"
      ],
      "transport": "stdio",
      "enabled": true,
      "workspaceScoped": true,
      "_note": "Enabled after WorkspaceMcpBridge isolation was added (PR #62). All tool calls must be routed through WorkspaceMcpBridge — never called directly. The './workspace' arg is an advisory default; each session uses its own root via the bridge.",
      "allowedTools": [
        "read_file",
        "read_multiple_files",
        "write_file",
        "create_directory",
        "move_file",
        "list_directory",
        "directory_tree",
        "get_file_info",
        "search_files"
      ]
    },
    "github-architecture": {
      "command": "node",
      "args": [
        "src/mcp/githubMcpServer.js"
      ],
      "transport": "stdio",
      "enabled": true,
      "allowedTools": [
        "github_get_repo_info"
      ]
    }
  }
}
