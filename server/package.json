{
  "name": "agentic-server",
  "version": "1.0.0",
  "type": "module",
  "description": "Pure JavaScript backend for the Agentic CLI — AI agent platform with MCP, WebSockets, and GitHub integration",
  "main": "src/server.js",
  "scripts": {
    "build": "node --check src/server.js && node --check src/db/migrator.js",
    "start": "node src/server.js",
    "start:worker": "node src/worker/executionWorker.js",
    "dev": "node --watch src/server.js",
    "test": "node --test src/**/*.test.js",
    "bench:event-bus": "node ../benchmarks/event-bus.mjs",
    "bench:websocket": "node ../benchmarks/websocket-load.mjs",
    "bench:redis-lease": "node ../benchmarks/redis-lease-fault.mjs",
    "worker:repo-agent": "node src/worker/repoAgentWorker.js",
    "start:stack": "node src/server.js",
    "bench:browser": "node ../benchmarks/browser-acceptance.mjs",
    "browser:install": "bash scripts/install-browser-runtime.sh",
    "db:migrate": "node src/db/migrator.js",
    "db:status": "node src/db/migrator.js --status",
    "db:migrate:sqlite": "node ../scripts/migrate-sqlite-to-postgres.mjs",
    "db:backup": "node ../scripts/neon-db-backup.mjs backup",
    "db:restore": "node ../scripts/neon-db-backup.mjs restore"
  },
  "dependencies": {
    "@octokit/rest": "^21.0.0",
    "@tavily/core": "^0.5.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "mysql2": "^3.24.2",
    "node-cache": "^5.1.2",
    "node-pty": "^1.1.0",
    "openai": "^4.73.0",
    "pg": "^8.23.0",
    "uuid": "^10.0.0",
    "winston": "^3.15.0",
    "ws": "^8.18.0",
    "web-tree-sitter": "^0.27.2",
    "tree-sitter-wasm": "^2.0.4",
    "playwright": "^1.65.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "Atharv",
  "license": "MIT"
}
