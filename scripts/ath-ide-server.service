[Unit]
Description=ATH IDE Core API & Web Studio
After=network.target docker.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/ath-ide/server
EnvironmentFile=/etc/ath-ide/api.env
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

